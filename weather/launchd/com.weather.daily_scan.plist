<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.weather.daily_scan</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>/Users/xiong/weather/weather/scripts/daily_scan_and_settlement.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>2</integer>
      <key>Minute</key>
      <integer>10</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>SoftResourceLimits</key>
    <dict>
      <key>NumberOfFiles</key>
      <integer>8192</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
      <key>NumberOfFiles</key>
      <integer>8192</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/xiong/weather/weather/data/logs/daily_scan.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xiong/weather/weather/data/logs/daily_scan.err.log</string>
  </dict>
</plist>
