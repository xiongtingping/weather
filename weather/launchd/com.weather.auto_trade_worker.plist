<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.weather.auto_trade_worker</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/xiong/weather/scripts/auto_trade_worker.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>SoftResourceLimits</key>
    <dict>
      <key>NumberOfFiles</key>
      <integer>8192</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
      <key>NumberOfFiles</key>
      <integer>8192</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/xiong/weather</string>

    <key>StandardOutPath</key>
    <string>/Users/xiong/weather/data/logs/auto_trade_worker.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xiong/weather/data/logs/auto_trade_worker.err.log</string>
  </dict>
</plist>
