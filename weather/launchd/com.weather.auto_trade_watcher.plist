<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.weather.auto_trade_watcher</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>set -a; source /Users/xiong/weather/.env; set +a; ulimit -Sn ${PM_NOFILE_SOFT:-8192} 2&gt;/dev/null || true; /Users/xiong/weather/.venv/bin/python /Users/xiong/weather/scripts/auto_trade_watcher.py --interval 10 --no-sms</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>SoftResourceLimits</key>
    <dict>
      <key>NumberOfFiles</key>
      <integer>8192</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
      <key>NumberOfFiles</key>
      <integer>8192</integer>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/xiong/weather</string>
    <key>StandardOutPath</key>
    <string>/Users/xiong/weather/data/logs/auto_trade_watcher.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xiong/weather/data/logs/auto_trade_watcher.err.log</string>
  </dict>
</plist>
