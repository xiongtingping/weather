# Runtime / local-only artifacts (SSOT: do not commit)

# OS junk
.DS_Store
Thumbs.db

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# Local databases, logs, locks, caches
data/
logs/
*.log
*.pid
*.lock
*.lock/

# Secrets / env
.env

# output/audits: every investigation/backfill/audit script under scripts/
# writes its one-off packet here, and nothing ever removed one.  Measured
# 2026-08-17: 3.7GiB across 19,140 files, 96% older than 14 days, none read
# by any resident path -- and 19,513 historical commits of it had already
# grown .git itself to 954MiB.  scripts/output_audits_retention.py now prunes
# the working tree by age, but that only ever reclaims disk, not git history;
# excluding the directory is what stops the next one-off dump from repeating
# the same growth in commits.  (Supersedes the older, narrower rule that only
# ignored canonical_contract.json snapshots under here -- ignoring the whole
# directory subsumes it.)
output/audits/

# Analysis caches and oversized rendered artifacts (2026-08-29).  tmp/ is a
# tracked directory -- probes belong in history -- but a 1.0GB pickle cache
# and multi-megabyte rendered HTML are not source: GitHub rejects the push
# outright, and the tree is 27GB of database already.
tmp/*.pkl
tmp/cal_dashboard_preview.html
tmp/h1_night_ceiling_rows.json
# Hot update sidecars (2026-09-16): the last full render's payload and the page version.
tmp/cal_dashboard_payload.json
tmp/cal_dashboard_version.js

# Local tooling (2026-11-02): the hot-layer venv symlink, browser automation scratch, merge leftovers.
.venv
.playwright-cli/
output/playwright/
*.orig

