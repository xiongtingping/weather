<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.weather.clob_order_service</string>
    <!-- Interactive: launchd's default (Standard) runs the job and every sweep it
         spawns at utility QoS, which on this M1 (4P+4E) is held to the efficiency
         cores once the box is busy; station x model weights took 789 s there
         against 83 s at default QoS (2026-10-30), past its 900 s sweep budget. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/xiong/weather/scripts/clob_order_service.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/Users/xiong/weather</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>WEATHER_SERVICE_DOMAIN</key>
      <string>user</string>
      <key>PM_TARGET_EXECUTION_MODE</key>
    <string>production_no_live</string>
      <key>PM_CLOB_ORDER_SERVICE_READ_ONLY</key>
      <string>1</string>
      <key>PM_CLOB_BALANCE_PREFETCH_ENABLED</key>
      <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/xiong/weather/data/logs/clob_order_service.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xiong/weather/data/logs/clob_order_service.err.log</string>
    <key>SoftResourceLimits</key>
    <dict>
      <key>NumberOfFiles</key>
      <integer>8192</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
      <key>NumberOfFiles</key>
      <integer>8192</integer>
    </dict>
  </dict>
</plist>
