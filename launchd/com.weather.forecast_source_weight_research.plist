<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.weather.forecast_source_weight_research</string>
    <key>UserName</key>
    <string>xiong</string>
    <key>GroupName</key>
    <string>staff</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/Users/xiong</string>
      <key>USER</key>
      <string>xiong</string>
      <key>LOGNAME</key>
      <string>xiong</string>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
      <key>PYTHONUNBUFFERED</key>
      <string>1</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/bin/env</string>
      <string>python3</string>
      <string>/Users/xiong/weather/scripts/forecast_source_weight_daily_pipeline.py</string>
      <string>--execute</string>
      <string>--max-incremental-requests</string>
      <string>12</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>2</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/Users/xiong/weather</string>
    <key>StandardOutPath</key>
    <string>/Users/xiong/weather/data/logs/forecast_source_weight_research.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xiong/weather/data/logs/forecast_source_weight_research.err.log</string>
  </dict>
</plist>
