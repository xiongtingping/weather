<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.weather.official_nwp_raw_retention</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/xiong/weather/scripts/official_nwp_raw_retention_daily.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/xiong/weather</string>
  <!-- Daily, not weekly: ecmwf_pf50 alone writes roughly 7 GB/day into a
       store with no eviction, which is what filled the disk on 2026-08-11.
       05:20 sits after the overnight capture rotation and before the market
       day. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>20</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- The pass only ever discards bodies that no reference document names,
         and never the receipts or curves that are the actual evidence.  The
         plan is written before anything is deleted either way. -->
    <key>PM_OFFICIAL_NWP_NATIVE_RETENTION_APPLY</key>
    <string>1</string>
    <!-- An unreferenced body younger than this may still belong to a capture
         that has not written its packet yet. -->
    <key>PM_OFFICIAL_NWP_NATIVE_RETENTION_MIN_AGE_DAYS</key>
    <string>2</string>
    <!-- Budget lane.  The unreferenced lane can only reclaim what nothing
         names, and capture packets are kept forever, so the bodies their
         field_receipts pin keep the store climbing about a gigabyte a day
         after a clean pass.  This caps data/runtime/official_nwp_sources at
         12 GiB, oldest first, and only touches stores whose receipts carry an
         S3 object_key plus byte range; ecmwf_pf50 and gefs are re-obtainable
         that way, ICON/DWD is not and is deliberately absent.  The job exits
         non-zero when the cap can no longer be held, so a silently useless
         pass shows up in launchctl instead of only in the log. -->
    <key>PM_OFFICIAL_NWP_NATIVE_RETENTION_BUDGET_ROOT</key>
    <string>/Users/xiong/weather/data/runtime/official_nwp_sources</string>
    <key>PM_OFFICIAL_NWP_NATIVE_RETENTION_BUDGET_BYTES</key>
    <string>7516192768</string>
    <key>PM_OFFICIAL_NWP_NATIVE_RETENTION_BUDGET_STORES</key>
    <string>ecmwf_pf50/raw gefs/raw</string>
    <!-- Left at 0 deliberately.  A reference document this user cannot read
         cannot prove a body is garbage, so the pass refuses rather than
         guesses; twelve root-owned 0600 files under data/research currently
         trip it, and the log names them.  Repair their ownership rather than
         setting this to 1. -->
    <key>PM_OFFICIAL_NWP_NATIVE_RETENTION_ALLOW_UNREADABLE_REFS</key>
    <string>0</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/xiong/weather/data/logs/official_nwp_raw_retention.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/xiong/weather/data/logs/official_nwp_raw_retention.err.log</string>
</dict>
</plist>
