<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.weather.dashboard_health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/xiong/weather/scripts/dashboard_health_sweep.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/xiong/weather</string>
  <!-- 系统健康快刷 (user 2026-10-21 「系统健康的渲染提高优先级」): the health
       page's cheap every-run sections every five minutes, then the page
       drawn read-only.  A reader of the store; skips its compute with the
       WAL past the resident's line. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/xiong/weather/data/logs/dashboard_health.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/xiong/weather/data/logs/dashboard_health.err.log</string>
</dict>
</plist>
