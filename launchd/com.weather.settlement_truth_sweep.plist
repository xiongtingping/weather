<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.weather.settlement_truth_sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/xiong/weather/scripts/settlement_truth_sweep.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/xiong/weather</string>
  <!-- Every half hour.  A station-day settles once, so nothing is gained by
       asking more often than the slowest timezone closes; what the interval
       has to guarantee is that no day can slip past unasked, which is the
       failure this exists to end.  A pass over an empty backlog is a few
       seconds of reading and writes nothing. -->
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/xiong/weather/data/logs/settlement_truth_sweep.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/xiong/weather/data/logs/settlement_truth_sweep.err.log</string>
</dict>
</plist>
