<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.weather.maker_shadow_probe</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/xiong/weather/scripts/maker_shadow_probe_sweep.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/xiong/weather</string>
  <!-- Every five minutes, because the shortest horizon under test is five
       and a resting order that expires between two passes would be recorded
       as expired without ever having been checked.  The pass itself writes
       one intent per scope per quarter hour (the probe throttles itself);
       the extra frequency is entirely for resolving fills promptly against
       a book that updates about 144 times a minute. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/xiong/weather/data/logs/maker_shadow_probe.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/xiong/weather/data/logs/maker_shadow_probe.err.log</string>
</dict>
</plist>
