<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.weather.market_ws</string>
    <!-- Interactive: launchd's default (Standard) runs the job and every sweep it
         spawns at utility QoS, which on this M1 (4P+4E) is held to the efficiency
         cores once the box is busy; station x model weights took 789 s there
         against 83 s at default QoS (2026-10-30), past its 900 s sweep budget. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>/Users/xiong/weather/scripts/market_ws_listener.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/xiong/weather</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PM_TARGET_EXECUTION_MODE</key>
      <string>production_no_live</string>
      <key>WEATHER_SERVICE_DOMAIN</key>
      <string>user</string>
      <key>PM_MARKET_WS_PROXY</key>
      <string>direct_then_env</string>
      <key>PM_MARKET_WS_HTTP_PROXY</key>
      <string>http://127.0.0.1:1082</string>
      <key>HTTP_PROXY</key>
      <string>http://127.0.0.1:1082</string>
      <key>HTTPS_PROXY</key>
      <string>http://127.0.0.1:1082</string>
      <key>ALL_PROXY</key>
      <string>http://127.0.0.1:1082</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>SoftResourceLimits</key>
    <dict>
      <key>NumberOfFiles</key>
      <integer>8192</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
      <key>NumberOfFiles</key>
      <integer>8192</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/xiong/weather/data/logs/market_ws.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xiong/weather/data/logs/market_ws.err.log</string>
  </dict>
</plist>
