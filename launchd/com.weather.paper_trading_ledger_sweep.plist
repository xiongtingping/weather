<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.weather.paper_trading_ledger_sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/xiong/weather/scripts/paper_trading_ledger_sweep.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/xiong/weather</string>
  <!-- Every quarter hour.  A pass is about half a minute of reading and
       writes nothing when there is nothing new, and the resident runs
       essentially back to back, so waiting for a quiet moment would mean
       never running at all.  Overlapping is fine: see the script for why the
       scan cannot take the lock away from the resident. -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/xiong/weather/data/logs/paper_trading_ledger_sweep.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/xiong/weather/data/logs/paper_trading_ledger_sweep.err.log</string>
</dict>
</plist>
