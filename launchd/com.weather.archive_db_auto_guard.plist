<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.weather.archive_db_auto_guard</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>/Users/xiong/weather/scripts/archive_db_auto_guard.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/xiong/weather</string>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PM_ARCHIVE_GUARD_MAX_DB_BYTES</key>
      <string>18g</string>
      <key>PM_ARCHIVE_GUARD_MIN_FREE_BYTES</key>
      <string>24g</string>
      <key>PM_ARCHIVE_GUARD_MAX_WAL_BYTES</key>
      <string>256m</string>
      <key>PM_ARCHIVE_GUARD_KEEP_FACTS_DAYS</key>
      <string>0</string>
      <key>PM_ARCHIVE_GUARD_KEEP_RUNS_DAYS</key>
      <string>2</string>
      <key>PM_ARCHIVE_GUARD_KEEP_SNAPSHOTS_DAYS</key>
      <string>2</string>
      <key>PM_ARCHIVE_GUARD_KEEP_JOBS_DAYS</key>
      <string>2</string>
      <key>PM_ARCHIVE_GUARD_KEEP_TICKS_DAYS</key>
      <string>2</string>
      <key>PM_ARCHIVE_GUARD_KEEP_BACKUP</key>
      <string>0</string>
      <key>PM_ARCHIVE_GUARD_QUIESCE_TIMEOUT_SEC</key>
      <string>90</string>
      <key>PM_ARCHIVE_GUARD_BUILD_TIMEOUT_SEC</key>
      <string>7200</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/xiong/weather/data/logs/archive_db_auto_guard.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xiong/weather/data/logs/archive_db_auto_guard.err.log</string>
    <key>SoftResourceLimits</key>
    <dict>
      <key>NumberOfFiles</key>
      <integer>8192</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
      <key>NumberOfFiles</key>
      <integer>8192</integer>
    </dict>
  </dict>
</plist>
