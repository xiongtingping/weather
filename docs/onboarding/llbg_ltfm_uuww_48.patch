@@ -21,12 +21,24 @@ SCHEMA = "bayes_basket_target_station_coordinate_registry_v1"
 SOURCE_SCHEMA = "awc_stationinfo_v1"
 SOURCE_ID = "awc_stationinfo"
 SOURCE_URL = "https://aviationweather.gov/api/data/stationinfo"
+# The founding snapshot: the one AWC stationinfo response the original
+# 45-station corpus was projected from.
 SOURCE_SNAPSHOT_SHA256 = "22d624dbadff44141d4abdd6938873958e8b7a334a2d6f1394575e49c2f50ec6"
+# The 2026-08-30 onboarding snapshot: a second stationinfo response, fetched
+# for exactly the three ids it admits (614 bytes).  Kept as its own block
+# rather than folded into a re-taken fleet-wide snapshot, because re-taking
+# one would silently move the 45 coordinates already in production -- AWC
+# revises values -- and a registry that claims a snapshot it did not project
+# from is claiming provenance it does not have.  Every station reports the
+# snapshot it actually came from; see ``_SNAPSHOT_BY_STATION``.
+ONBOARDED_SNAPSHOT_SHA256 = (
+    "b5b5b43754ed61009bc46d16d57eca3d6a2ef4498578c4cff5d5496c887c1cdd"
+)
 
 # Official AWC stationinfo lat/lon values.  Keep this projection intentionally
 # small: elevation, city labels, and provider fields do not belong in the
 # native model decoder's coordinate contract.
-_COORDINATES: dict[str, tuple[float, float]] = {
+_FOUNDING_COORDINATES: dict[str, tuple[float, float]] = {
     "CYYZ": (43.679, -79.629),
     "EDDM": (48.348, 11.813),
     "EFHK": (60.327, 24.957),
@@ -74,6 +86,36 @@ _COORDINATES: dict[str, tuple[float, float]] = {
     "ZUUU": (30.576, 103.95),
 }
 
+# Admitted 2026-08-30 from ``ONBOARDED_SNAPSHOT_SHA256``.  Three markets that
+# had been listed and settleable for weeks -- settlement timezone present,
+# station id resolved from the settlement URL, 23-24 METARs a day -- and were
+# refused only here, because a station with no coordinate cannot be decoded
+# and must never be silently decoded at a guessed location.
+_ONBOARDED_COORDINATES: dict[str, tuple[float, float]] = {
+    "LLBG": (32.011, 34.887),
+    "LTFM": (41.262, 28.74),
+    "UUWW": (55.592, 37.261),
+}
+
+_COORDINATES: dict[str, tuple[float, float]] = {
+    **_FOUNDING_COORDINATES,
+    **_ONBOARDED_COORDINATES,
+}
+if len(_COORDINATES) != len(_FOUNDING_COORDINATES) + len(
+    _ONBOARDED_COORDINATES
+):
+    # An id in both blocks would take the onboarded value while the founding
+    # snapshot still claimed it.  Loud, because it is a provenance error.
+    raise ContractError("native_station_coordinate_block_overlap")
+
+_SNAPSHOT_BY_STATION: dict[str, str] = {
+    **{station: SOURCE_SNAPSHOT_SHA256 for station in _FOUNDING_COORDINATES},
+    **{
+        station: ONBOARDED_SNAPSHOT_SHA256
+        for station in _ONBOARDED_COORDINATES
+    },
+}
+
 
 def _canonical(value: Any) -> bytes:
     return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
@@ -101,7 +143,8 @@ def station_coordinates(station_id: str) -> dict[str, Any]:
         "source_schema": SOURCE_SCHEMA,
         "source_id": SOURCE_ID,
         "source_url": SOURCE_URL,
-        "source_snapshot_sha256": SOURCE_SNAPSHOT_SHA256,
+        # This station's own snapshot, not the registry's first one.
+        "source_snapshot_sha256": _SNAPSHOT_BY_STATION[station],
     }
 
 
@@ -114,10 +157,33 @@ def coordinate_registry_manifest() -> dict[str, Any]:
         "source_schema": SOURCE_SCHEMA,
         "source_id": SOURCE_ID,
         "source_url": SOURCE_URL,
+        # Kept for readers that predate the second block; it names the
+        # snapshot the founding corpus came from and nothing else.
         "source_snapshot_sha256": SOURCE_SNAPSHOT_SHA256,
+        # The whole lineage, one entry per snapshot this registry projects
+        # from, so an auditor can see which stations each one accounts for
+        # without reading the module.
+        "source_snapshots": [
+            {
+                "source_snapshot_sha256": SOURCE_SNAPSHOT_SHA256,
+                "station_count": len(_FOUNDING_COORDINATES),
+                "station_ids": sorted(_FOUNDING_COORDINATES),
+            },
+            {
+                "source_snapshot_sha256": ONBOARDED_SNAPSHOT_SHA256,
+                "station_count": len(_ONBOARDED_COORDINATES),
+                "station_ids": sorted(_ONBOARDED_COORDINATES),
+            },
+        ],
         "station_count": len(_COORDINATES),
         "station_ids": sorted(_COORDINATES),
     }
 
 
-__all__ = ["REGISTRY_SHA256", "SCHEMA", "coordinate_registry_manifest", "station_coordinates"]
+__all__ = [
+    "ONBOARDED_SNAPSHOT_SHA256",
+    "REGISTRY_SHA256",
+    "SCHEMA",
+    "coordinate_registry_manifest",
+    "station_coordinates",
+]
